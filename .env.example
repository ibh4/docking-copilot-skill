# DockingCopilot Skill 环境变量示例
# 复制为 .env 并按需修改；不要把真实密钥或绝对个人路径提交到仓库。

# 后端服务
DOCKSKILL_HOST=127.0.0.1
DOCKSKILL_PORT=8000
DOCKSKILL_WORKERS=1

# 对接并发与批量上限（16GB 内存约束）
DOCKSKILL_DOCK_CONCURRENCY=1
DOCKSKILL_BATCH_MAX_LIGANDS=20

# 可选：显式指定 Vina 可执行文件（默认自动探测环境内 vina，
# 其次 vendor/bin/vina）
# DOCKSKILL_VINA_EXECUTABLE=

# 可选：输出目录（默认项目根目录下 outputs/）
# DOCKSKILL_OUTPUTS_DIR=
